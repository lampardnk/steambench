{
  "providers": {
    "experiential": {
      "baseUrl": "https://api.experientiallabs.ai/v1",
      "api": "openai-completions",
      "apiKey": "$EXPLABS_API_KEY",
      "models": [
        {
          "id": "gpt-5.6-luna",
          "name": "Experiential GPT-5.6 Luna",
          "reasoning": true,
          "input": [
            "text",
            "image"
          ],
          "contextWindow": 1050000,
          "maxTokens": 65536,
          "thinkingLevelMap": {
            "max": "max"
          },
          "compat": {
            "supportsStore": false,
            "supportsReasoningEffort": true,
            "maxTokensField": "max_tokens"
          }
        }
      ]
    }
  }
}
