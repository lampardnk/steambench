#!/usr/bin/env bash
# steambench player entrypoint (reference implementation of the player contract).
#
# Contract: when STEAMBENCH_PLAYER_MODE=rpc is set and no arguments are given,
# the container must speak Pi's JSONL RPC protocol on stdin/stdout. Extra
# arguments are passed straight to Pi (for example: --print --no-session -- "prompt").
set -euo pipefail
args=("$@")
if [ "${STEAMBENCH_PLAYER_MODE:-}" = "rpc" ] && [ "$#" -eq 0 ]; then
    args=(--mode rpc --no-session)
fi
skill_args=()
if [ -d "${STEAMBENCH_SKILLS_DIR:-/workspace/skills}" ]; then
    for d in "${STEAMBENCH_SKILLS_DIR:-/workspace/skills}"/*/; do
        [ -f "$d/SKILL.md" ] && skill_args+=(--skill "$d")
    done
fi
exec pi \
    --provider openrouter \
    --model "${STEAMBENCH_MODEL:-nvidia/nemotron-3-super-120b-a12b:free}" \
    --no-extensions \
    --no-context-files \
    --no-skills \
    -e /opt/steambench/extensions/sts2.ts \
    "${skill_args[@]}" \
    "${args[@]}"
